# ── GraphSentinel Next.js environment ─────────────────────────────
# Copy this file to `.env.local` and fill in your values.

# Supabase (Postgres) — required
# Create a project at https://supabase.com, then run the two migrations in
# `supabase/migrations/` against it. Copy the URL and anon key from
# Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Python ML service (TensorFlow) — runs unchanged from the original project.
# Start it with:  npm run backend:ml:win   (or `python backend/ml_service.py`)
ML_SERVICE_URL=http://127.0.0.1:8790

# Optional: legacy Vite-style env names are also accepted as fallbacks.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=

# ── Vector DB (pgvector) + FalkorDB ────────────────────────────────
# pgvector is enabled via the Supabase migration (no extra config needed).
# FalkorDB: set your cloud instance URL (Redis protocol).
# Format: redis://default:<password>@<host>:<port>
FALKORDB_URL=redis://default:your-password@your-instance.falkordb.cloud:port